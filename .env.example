# Copia a .env y ajusta. docker compose lo lee automaticamente.
# Por defecto no hace falta configurar nada: el motor OCR corre en el propio NAS.

VISION_BACKEND=ocr

# --- Solo si VISION_BACKEND=ollama ---
# IP de la maquina donde corre Ollama, alcanzable desde el NAS.
# En esa maquina: OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_HOST=http://192.168.1.50:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT=600

# --- Solo si VISION_BACKEND=claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
