# Copy to .env and adjust. docker compose reads it automatically.
# By default there is nothing to configure: the OCR engine runs in the container.

VISION_BACKEND=ocr

# --- Only if VISION_BACKEND=ollama ---
# IP of the machine running Ollama, reachable from this host.
# On that machine: OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_HOST=http://192.168.1.50:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT=600

# --- Only if VISION_BACKEND=claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
